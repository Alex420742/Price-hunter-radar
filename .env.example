# Token from @BotFather — store as a hosting secret, never commit a real token
TELEGRAM_BOT_TOKEN=

# Your personal numeric Telegram chat ID (private bot control)
TELEGRAM_CHAT_ID=

# Destination channel numeric ID, e.g. -100... (bot must be channel admin)
TELEGRAM_CHANNEL_ID=-1001875596181

DATABASE_PATH=data/price_hunter.db
SCANNER_ENABLED=false
